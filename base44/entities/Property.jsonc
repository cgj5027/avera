{
  "name": "Property",
  "type": "object",
  "properties": {
    "nickname": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "property_type": {
      "type": "string",
      "enum": [
        "primary_residence",
        "rental",
        "investment",
        "vacation",
        "other"
      ],
      "default": "primary_residence"
    },
    "estimated_value": {
      "type": "number",
      "minimum": 0
    },
    "valuation_source": {
      "type": "string",
      "enum": [
        "user_provided",
        "external_provider"
      ],
      "default": "user_provided"
    },
    "valuation_date": {
      "type": "string",
      "format": "date"
    },
    "valuation_notes": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "description": "Where the figure came from: Manual, Sample data, Plaid Sandbox, or Estimated."
    },
    "taxes_monthly": {
      "type": "number",
      "default": 0,
      "minimum": 0
    },
    "insurance_monthly": {
      "type": "number",
      "default": 0,
      "minimum": 0
    },
    "hoa_monthly": {
      "type": "number",
      "default": 0,
      "minimum": 0
    },
    "maintenance_monthly": {
      "type": "number",
      "default": 0,
      "minimum": 0
    },
    "notes": {
      "type": "string"
    },
    "demo_profile": {
      "type": "string",
      "description": "Demo Mode workspace this record belongs to: early_career, multi_income, or financial_improvement. Empty for ordinary records; demo reset only removes records carrying this tag for the signed-in user."
    }
  },
  "required": [
    "nickname",
    "estimated_value"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}