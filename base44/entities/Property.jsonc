{
  "name": "Property",
  "type": "object",
  "properties": {
    "nickname": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "property_type": {
      "type": "string",
      "enum": [
        "primary_residence",
        "rental",
        "investment",
        "vacation",
        "other"
      ],
      "default": "primary_residence"
    },
    "estimated_value": {
      "type": "number",
      "minimum": 0
    },
    "valuation_source": {
      "type": "string",
      "enum": [
        "user_provided",
        "external_provider"
      ],
      "default": "user_provided"
    },
    "valuation_date": {
      "type": "string",
      "format": "date"
    },
    "valuation_notes": {
      "type": "string"
    },
    "taxes_monthly": {
      "type": "number",
      "default": 0,
      "minimum": 0
    },
    "insurance_monthly": {
      "type": "number",
      "default": 0,
      "minimum": 0
    },
    "hoa_monthly": {
      "type": "number",
      "default": 0,
      "minimum": 0
    },
    "maintenance_monthly": {
      "type": "number",
      "default": 0,
      "minimum": 0
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "nickname",
    "estimated_value"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "user_condition": {
        "id": "{{user.id}}"
      }
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
