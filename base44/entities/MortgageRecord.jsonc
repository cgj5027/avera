{
  "name": "MortgageRecord",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string"
    },
    "lender": {
      "type": "string"
    },
    "outstanding_balance": {
      "type": "number",
      "default": 0,
      "minimum": 0
    },
    "monthly_payment": {
      "type": "number",
      "default": 0,
      "minimum": 0
    },
    "interest_rate": {
      "type": "number",
      "minimum": 0
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "property_id"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "user_condition": {
        "id": "{{user.id}}"
      }
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
