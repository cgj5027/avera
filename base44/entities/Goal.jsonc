{
  "name": "Goal",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "target_amount": {
      "type": "number",
      "minimum": 0
    },
    "saved_amount": {
      "type": "number",
      "default": 0,
      "minimum": 0
    },
    "target_date": {
      "type": "string",
      "format": "date"
    },
    "source": {
      "type": "string",
      "description": "Where the figure came from: Manual, Sample data, Plaid Sandbox, or Estimated."
    },
    "notes": {
      "type": "string"
    },
    "demo_profile": {
      "type": "string",
      "description": "Demo Mode workspace this record belongs to: early_career, multi_income, or financial_improvement. Empty for ordinary records; demo reset only removes records carrying this tag for the signed-in user."
    }
  },
  "required": [
    "name",
    "target_amount"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}