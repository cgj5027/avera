{
  "name": "JobProfile",
  "type": "object",
  "properties": {
    "skills": {
      "type": "string"
    },
    "experience": {
      "type": "string"
    },
    "preferred_roles": {
      "type": "string"
    },
    "work_mode": {
      "type": "string",
      "enum": [
        "any",
        "remote",
        "hybrid",
        "onsite"
      ],
      "default": "any"
    },
    "location": {
      "type": "string"
    },
    "weekly_hours": {
      "type": "integer"
    },
    "target_monthly_income": {
      "type": "number"
    }
  },
  "required": [
    "skills"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}