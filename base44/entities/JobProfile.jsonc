{
  "name": "JobProfile",
  "type": "object",
  "properties": {
    "skills": {
      "type": "string"
    },
    "experience": {
      "type": "string"
    },
    "preferred_roles": {
      "type": "string"
    },
    "work_mode": {
      "type": "string",
      "enum": [
        "any",
        "remote",
        "hybrid",
        "onsite"
      ],
      "default": "any"
    },
    "location": {
      "type": "string"
    },
    "weekly_hours": {
      "type": "integer",
      "minimum": 0,
      "maximum": 80
    },
    "target_monthly_income": {
      "type": "number",
      "minimum": 0
    },
    "demo_profile": {
      "type": "string",
      "description": "Demo Mode workspace this record belongs to: early_career, multi_income, or financial_improvement. Empty for ordinary records; demo reset only removes records carrying this tag for the signed-in user."
    }
  },
  "required": [
    "skills"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "id": "{{user.id}}"
      }
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}