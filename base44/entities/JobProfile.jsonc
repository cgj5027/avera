{
  "name": "JobProfile",
  "type": "object",
  "properties": {
    "skills": {
      "type": "string"
    },
    "experience": {
      "type": "string"
    },
    "experience_level": {
      "type": "string",
      "enum": [
        "entry_level",
        "mid_level",
        "senior"
      ],
      "default": "entry_level",
      "description": "Self-selected experience level used to filter job search results to listings suited to the candidate."
    },
    "preferred_roles": {
      "type": "string"
    },
    "job_type": {
      "type": "string",
      "enum": [
        "any",
        "full_time",
        "part_time",
        "temporary",
        "contract"
      ],
      "default": "any",
      "description": "Role type the candidate wants: full-time, part-time, temporary, or contract/gig. Used to filter job search results."
    },
    "work_mode": {
      "type": "string",
      "enum": [
        "any",
        "remote",
        "hybrid",
        "onsite"
      ],
      "default": "any"
    },
    "location": {
      "type": "string"
    },
    "demo_profile": {
      "type": "string",
      "description": "Demo Mode workspace this record belongs to: early_career, multi_income, or financial_improvement. Empty for ordinary records; demo reset only removes records carrying this tag for the signed-in user."
    },
    "interests": {
      "type": "string",
      "description": "Preferred industries and work activities for opportunity matching."
    }
  },
  "required": [
    "skills"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
