{
  "name": "Bill",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "minimum": 0
    },
    "frequency": {
      "type": "string",
      "enum": [
        "weekly",
        "biweekly",
        "semimonthly",
        "monthly",
        "quarterly",
        "semiannual",
        "annual"
      ],
      "default": "monthly"
    },
    "next_due_date": {
      "type": "string",
      "format": "date"
    },
    "category": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "description": "Where the figure came from: Manual, Sample data, Plaid Sandbox, or Estimated."
    },
    "reminder_days": {
      "type": "number",
      "default": 3,
      "minimum": 0
    },
    "paid_this_cycle": {
      "type": "boolean",
      "default": false
    },
    "last_paid_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "recurrence_day": {
      "type": "integer",
      "minimum": 1,
      "maximum": 31,
      "description": "Original day of month for clamped calendar recurrences."
    },
    "demo_profile": {
      "type": "string",
      "description": "Demo Mode workspace this record belongs to: early_career, multi_income, or financial_improvement. Empty for ordinary records; demo reset only removes records carrying this tag for the signed-in user."
    },
    "suggestion_merchant": {
      "type": "string",
      "description": "Normalized merchant key for an accepted recurring-bill suggestion; prevents renamed accepted bills from being suggested again."
    }
  },
  "required": [
    "name",
    "amount"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
