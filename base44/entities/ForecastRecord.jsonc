{
  "name": "ForecastRecord",
  "type": "object",
  "properties": {
    "year": {
      "type": "number",
      "minimum": 0
    },
    "projected_income": {
      "type": "number",
      "minimum": 0
    },
    "projected_expenses": {
      "type": "number",
      "minimum": 0
    },
    "projected_savings": {
      "type": "number"
    },
    "year_end_cash": {
      "type": "number"
    },
    "assumptions": {
      "type": "string"
    },
    "plan_start_month": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
      "description": "First month in the rolling twelve-month projection."
    }
  },
  "required": [
    "year"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "user_condition": {
        "id": "{{user.id}}"
      }
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
