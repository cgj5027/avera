{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "description": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "minimum": 0
    },
    "type": {
      "type": "string",
      "enum": [
        "income",
        "expense"
      ],
      "default": "expense"
    },
    "category": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "source": {
      "type": "string",
      "description": "Where the figure came from: Manual, Sample data, Plaid Sandbox, or Estimated."
    },
    "notes": {
      "type": "string"
    },
    "not_recurring": {
      "type": "boolean",
      "default": false,
      "description": "User marked this charge as not recurring. It is excluded from recurring-bill detection now, and future charges with the same name stay unflagged."
    },
    "plaid_item_id": {
      "type": "string",
      "description": "Plaid Item the imported transaction came from. Empty for manual and demo records \u2014 importing never deletes or rewrites these."
    },
    "plaid_account_id": {
      "type": "string",
      "description": "Plaid account the imported transaction belongs to. Empty for manual and demo records."
    },
    "plaid_transaction_id": {
      "type": "string",
      "description": "Plaid's stable transaction identifier. Used as the upsert key so syncs are idempotent \u2014 modified transactions update in place instead of duplicating."
    }
  },
  "required": [
    "amount",
    "date"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}