{
  "name": "Account",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "checking",
        "savings",
        "credit_card",
        "cash",
        "investment",
        "other"
      ],
      "default": "checking"
    },
    "balance": {
      "type": "number",
      "default": 0
    },
    "institution": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "description": "Where the figure came from: Manual, Sample data, Plaid Sandbox, or Estimated."
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}