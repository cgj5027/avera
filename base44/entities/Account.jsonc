{
  "name": "Account",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "checking",
        "savings",
        "credit_card",
        "cash",
        "investment",
        "other"
      ],
      "default": "checking"
    },
    "balance": {
      "type": "number",
      "default": 0
    },
    "institution": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "description": "Where the figure came from: Manual, Sample data, Plaid Sandbox, or Estimated."
    },
    "notes": {
      "type": "string"
    },
    "plaid_item_id": {
      "type": "string",
      "description": "Plaid Item this imported account belongs to. Empty for manual accounts \u2014 this is the reconciliation boundary between manual and imported accounts."
    },
    "plaid_account_id": {
      "type": "string",
      "description": "Plaid's stable account identifier. Used as the upsert key so a reconnected or re-synced account is never duplicated; empty for manual accounts."
    },
    "balance_available": {
      "type": "number",
      "description": "Plaid available balance for imported accounts; empty for manual accounts."
    },
    "balance_limit": {
      "type": "number",
      "description": "Plaid credit limit for imported liability accounts; empty otherwise."
    },
    "demo_profile": {
      "type": "string",
      "description": "Demo Mode workspace this record belongs to: early_career, multi_income, or financial_improvement. Empty for ordinary records; demo reset only removes records carrying this tag for the signed-in user."
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}