{
  "name": "BudgetCategory",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "monthly_limit": {
      "type": "number",
      "default": 0,
      "minimum": 0
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "user_condition": {
        "id": "{{user.id}}"
      }
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
