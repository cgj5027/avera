{
  "name": "PlaidItem",
  "type": "object",
  "properties": {
    "item_id": {
      "type": "string",
      "description": "Plaid's stable Item identifier. Used as the idempotency key (upsert key) so one connection is never stored twice."
    },
    "institution_id": {
      "type": "string",
      "description": "Plaid institution id of the connected simulated institution."
    },
    "institution_name": {
      "type": "string",
      "description": "Display name of the connected institution."
    },
    "access_token": {
      "type": "string",
      "description": "Legacy field, inaccessible to clients. Reconnect old Items after deploying the private credential store.",
      "rls": {
        "create": false,
        "read": false,
        "update": false,
        "delete": false
      }
    },
    "products": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Plaid products enabled for this Item (e.g. transactions, auth, balance)."
    },
    "sync_cursor": {
      "type": "string",
      "description": "Persistent /transactions/sync cursor for this Item; empty string means a fresh Item with no sync yet."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "error",
        "needs_reauth",
        "disconnected"
      ],
      "default": "active",
      "description": "Connection status shown in the UI. Never color-only \u2014 always paired with the status icon and label."
    },
    "last_synced_at": {
      "type": "string",
      "description": "ISO timestamp of the last successful /transactions/sync run."
    },
    "last_sync_error": {
      "type": "string",
      "description": "Human-readable error from the last failed sync, empty when healthy."
    },
    "demo_profile": {
      "type": "string",
      "description": "Demo Mode workspace this Item belongs to: early_career, multi_income, or financial_improvement. Empty for ordinary connections; demo reset only removes Items carrying this tag for the signed-in user."
    }
  },
  "required": [
    "item_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
