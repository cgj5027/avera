{
  "name": "HouseholdProfile",
  "type": "object",
  "properties": {
    "household_name": {
      "type": "string"
    },
    "household_type": {
      "type": "string",
      "enum": [
        "single_income",
        "multi_income"
      ],
      "default": "single_income"
    },
    "default_pay_frequency": {
      "type": "string",
      "enum": [
        "weekly",
        "biweekly",
        "semimonthly",
        "monthly",
        "quarterly",
        "semiannual",
        "annual"
      ],
      "default": "monthly"
    },
    "budget_style": {
      "type": "string",
      "enum": [
        "category_caps",
        "zero_based",
        "flexible"
      ],
      "default": "category_caps"
    },
    "emergency_fund_months": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "notes": {
      "type": "string"
    }
  },
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  },
  "required": []
}