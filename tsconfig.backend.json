{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "baseUrl": ".",
    "paths": {
      "npm:@base44/sdk@0.8.52": [
        "node_modules/@base44/sdk/dist/index.d.ts"
      ]
    }
  },
  "include": [
    "base44/runtime.d.ts",
    "base44/functions/*/entry.ts",
    "base44/shared/*.ts"
  ]
}
